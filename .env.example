# research-bot environment variables
# Copy to .env (gitignored) or export in your shell / CI secrets.
# `rb` loads <repo>/.env automatically at startup (existing env vars win).
# All are optional; config/config.yaml can set the same values.

# --- LLM (OpenAI-compatible) -------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_MODEL_FAST=deepseek-v4-flash
LLM_MODEL_STRONG=deepseek-v4-flash

# --- Search ------------------------------------------------------------------
# Local/remote SearXNG instance (JSON or HTML mode both supported).
SEARXNG_URL=http://43.155.145.78:58881
# GitHub API token (raises the 10 req/min anonymous limit to 30).
GITHUB_TOKEN=

# --- Email (SMTP) ------------------------------------------------------------
# SMTP_SSL=true  -> implicit TLS on 465;  false -> STARTTLS on 587
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_TO=you@example.com,second@example.com
EMAIL_ENABLED=0
